{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm --filter @workspace/api-server run build"
    },
    "gla-campus-navigator": {
      "root": "artifacts/gla-campus-navigator",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm --filter @workspace/gla-campus-navigator run build",
      "outputDirectory": "dist/public",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm --filter @workspace/mockup-sandbox run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/mockups",
          "destination": "/index.html"
        },
        {
          "source": "/mockups/:path(.*)?",
          "destination": "/:path"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/mockups",
      "destination": {
        "service": "mockup-sandbox"
      }
    },
    {
      "source": "/mockups/(.*)",
      "destination": {
        "service": "mockup-sandbox"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "gla-campus-navigator"
      }
    }
  ]
}
